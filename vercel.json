{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?__vercel_route_path=/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api/[...path]?__vercel_route_path=/media/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
